 APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
VITE_APP_NAME="${APP_NAME}"

# MANJO PAYMENT GATEWAY (UAT / PRODUCTION)
MANJO_ENV=uat
MANJO_TIMEOUT=30

# Manjo QRIS Dynamic (SNAP BI)
MANJO_QRIS_BASE_URL=https://snap-uat.manjo.co.id/api
MANJO_QRIS_CLIENT_KEY=
MANJO_QRIS_CLIENT_SECRET=
MANJO_QRIS_PARTNER_ID=
MANJO_QRIS_MERCHANT_ID=
MANJO_QRIS_STORE_ID=
MANJO_QRIS_TERMINAL_ID=01
MANJO_QRIS_CHANNEL_ID=05
MANJO_QRIS_PRIVATE_KEY_PATH=storage/app/keys/manjo_merchant_private.key
MANJO_QRIS_PRIVATE_KEY=
MANJO_QRIS_PRIVATE_KEY_PASSPHRASE=
MANJO_QRIS_PUBLIC_KEY_PATH=storage/app/keys/manjo_merchant_public.key
MANJO_QRIS_SIGNATURE_ENCODING=hex
MANJO_QRIS_TOKEN_CACHE_TTL=840
MANJO_QRIS_VALIDITY_PERIOD=900
MANJO_QRIS_CALLBACK_URL=
MANJO_QRIS_ENDPOINT_URL=

# Manjo Virtual Account (VA)
MANJO_VA_BASE_URL=https://uat-api-dashboard.manjo.co.id
MANJO_VA_API_KEY=
MANJO_VA_CALLBACK_URL=
MANJO_VA_IP_WHITELIST=
MANJO_VA_EXPIRY_MINUTES=1440

# PAYMENT GATEWAY SWITCHING
PAYMENT_GATEWAY=tripay

# TRIPAY PAYMENT GATEWAY
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_API_URL=https://tripay.co.id/api-sandbox

# WhatsApp Gateway: messara (default) | wablas. Setelah diganti: php artisan config:clear
DEFAULT_WA_GATEWAY=messara
# Detik pesan identik ke nomor yang sama tidak dikirim ulang (0 = nonaktif)
WA_DEDUPE_TTL=600
# Nomor WA utama yang dikenal peserta (format 62...). Pesan dari nomor lain diberi catatan.
WA_PRIMARY_SENDER_NUMBER=
# WA_BACKUP_SENDER_NOTICE="_Pesan ini dikirim dari nomor lain milik :app. Nomor utama kami: wa.me/:primary_"

# Messara (gateway default)
MESSARA_DOMAIN_SERVER=https://messara.aksarateknologi.co.id
MESSARA_API_KEY=
MESSARA_SECRET_KEY=
MESSARA_SENDER_NUMBER=
# Template WhatsApp Official untuk invoice lunas (khusus Messara)
WA_USE_TEMPLATE=false
WA_INVOICE_TEMPLATE_NAME=invoice_pembayaran_berhasil

# Wablas (dipakai bila DEFAULT_WA_GATEWAY=wablas)
SECURITY_TOKEN_WABLAS=
SECRET_KEY_WABLAS=
DOMAIN_SERVER_WABLAS=https://sby.wablas.com
WABLAS_SENDER_NUMBER=

